{
  "ignoreClasses": [
    "active",
    "disabled",
    "error",
    "loading",
    "open",
    "selected",
    "visible"
  ],
  "ignoreClassPatterns": [
    "^cosmic-",
    "^cosmic-variant-",
    "^karaoke-atmosphere-",
    "^karaoke-flight-",
    "^library-song-card--",
    "^badge-"
  ],
  "generatedClassPrefixes": [
    "cosmic-",
    "karaoke-atmosphere-",
    "karaoke-flight-",
    "library-song-card--",
    "badge-"
  ],
  "allowedImportantSelectors": [],
  "allowedDuplicateSelectors": [":root", ":root[data-theme=\"light\"]"],
  "allowedZIndexes": [-1, 0, 1, 2, 5, 10, 20, 30, 40, 50, 100, 200, 500, 1000],
  "allowedBreakpoints": [480, 600, 700, 768, 900, 1000, 1200, 1280, 1440],
  "maxSelectorSpecificity": 50,
  "maxSelectorDepth": 6,
  "maxFileLines": 2000,
  "repeatedValueMinimum": 4,
  "strictRules": [
    "invalid-css",
    "transition-all",
    "javascript-url",
    "extreme-z-index"
  ]
}
