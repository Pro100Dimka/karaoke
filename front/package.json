{
  "name": "a-and-d-voice",
  "version": "0.3.44",
  "description": "A&D Voice — десктопное приложение (AI-караоке-тренажёр)",
  "author": "A&D Voice",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "vite",
    "dev:web": "node scripts/start-web.mjs",
    "dev:electron": "npm run build:lighting && concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build:lighting": "node scripts/build-lighting.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src electron --ext .js,.jsx,.cjs --ignore-pattern src/theme --ignore-pattern **/*OLD/**",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"electron/**/*.cjs\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"electron/**/*.cjs\" \"scripts/**/*.mjs\"",
    "check": "npm run check:imports && npm run lint && npm run format:check && npm run build",
    "check:imports": "node scripts/check-imports.mjs",
    "audit:css": "node scripts/audit-css-full.mjs --strict",
    "audit:exports": "node scripts/audit-exports.mjs",
    "check:sizes": "node scripts/check-file-sizes.mjs",
    "audit": "npm run check:syntax && npm run audit:openapi-contract && npm run audit:css && npm run audit:exports && npm run audit:reachability && npm run audit:react && npm run audit:cycles && npm run audit:complexity && npm run audit:semantic-density && npm run check:sizes && npm run audit:duplicates && npm run audit:media-auth && npm run audit:release-gate && npm run audit:portability && npm run audit:architecture && npm run audit:localization",
    "audit:react": "node scripts/audit-react.mjs",
    "audit:cycles": "node scripts/audit-cycles.mjs",
    "audit:complexity": "node scripts/audit-complexity.mjs",
    "audit:semantic-density": "node scripts/audit-semantic-density.mjs",
    "release:check": "node scripts/check-release.mjs",
    "audit:duplicates": "node scripts/audit-duplicates.mjs",
    "audit:architecture": "node scripts/audit-architecture.mjs",
    "audit:localization": "node scripts/audit-localization.mjs",
    "dev:mock": "cross-env VITE_USE_MOCK_API=true vite --mode mock",
    "build:mock": "cross-env VITE_USE_MOCK_API=true vite build --mode mock",
    "preview:mock": "vite preview --mode mock --host 127.0.0.1 --port 4173",
    "clean": "node scripts/clean.mjs",
    "generate:sbom": "node scripts/generate-sbom.mjs",
    "audit:openapi-contract": "node scripts/audit-openapi-contract.mjs",
    "verify": "npm run release:normalize && npm run check:imports && npm run lint && npm run format:check && npm run test:unit:coverage && npm run audit && npm run build",
    "audit:reachability": "node scripts/audit-reachability.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:mutation": "stryker run && node scripts/check-mutation-quality.mjs",
    "test:mutation:full": "cross-env MUTATION_INCLUDE_STATIC=true MUTATION_REPORT=../generated/mutation/business-logic-full.json stryker run && cross-env MUTATION_REPORT=../generated/mutation/business-logic-full.json node scripts/check-mutation-quality.mjs",
    "test:e2e": "playwright test",
    "test:e2e:real": "npm run test:integration:backend",
    "test:integration:backend": "cross-env VITE_USE_MOCK_API=false playwright test",
    "audit:media-auth": "node scripts/audit-media-auth.mjs",
    "test:e2e:electron-release": "playwright test -c playwright.release.config.mjs",
    "verify:release": "python ../scripts/release_gate.py",
    "audit:release-gate": "node scripts/audit-release-gate.mjs",
    "audit:portability": "node scripts/audit-portability.mjs",
    "release:normalize": "prettier --write \"src/**/*.{js,jsx,css}\" \"electron/**/*.cjs\" \"scripts/**/*.mjs\" && eslint src electron --ext .js,.jsx,.cjs --ignore-pattern src/theme --ignore-pattern **/*OLD/** --fix"
  },
  "dependencies": {
    "@pixi/react": "^7.1.2",
    "@pixi/unsafe-eval": "^7.4.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.10",
    "@xstate/react": "^6.1.0",
    "comlink": "^4.4.2",
    "formik": "^2.4.9",
    "lucide-react": "^0.383.0",
    "pixi.js": "^7.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^20.1.1",
    "react-router-dom": "^7.18.2",
    "three": "^0.185.1",
    "wavesurfer.js": "^7.12.11",
    "xstate": "^5.32.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/parser": "^8.0.4",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/traverse": "^8.0.4",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^8.2.2",
    "cross-env": "^10.0.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.54.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "fast-check": "^4.9.0",
    "jsdom": "^29.1.1",
    "patch-package": "8.0.1",
    "postcss": "^8.5.25",
    "postcss-selector-parser": "^7.1.4",
    "prettier": "3.9.6",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.karaokestudio.app",
    "productName": "A&D Voice",
    "files": [
      "package.json",
      {
        "from": "../generated/build/frontend/dist",
        "to": "dist"
      },
      "electron/**/*",
      "src/theme/palettes.css",
      "assets/icons/**/*"
    ],
    "extraResources": [
      {
        "from": "../generated/build/backend/dist/KaraokeBackend",
        "to": "backend"
      },
      {
        "from": "../downloads/engines/msst",
        "to": "backend/_internal/engines/msst"
      }
    ],
    "directories": {
      "output": "../generated/build/electron"
    },
    "win": {
      "extraResources": [
        {
          "from": "../generated/build/lighting/KeyboardLighting.node",
          "to": "lighting/KeyboardLighting.node"
        },
        {
          "from": "../generated/build/lighting/sources",
          "to": "lighting/sources"
        }
      ],
      "target": "dir",
      "icon": "assets/icons/app.ico"
    }
  },
  "overrides": {
    "qs": "6.15.3"
  },
  "engines": {
    "node": ">=22.18.0 <23 || >=24.11.0"
  }
}
