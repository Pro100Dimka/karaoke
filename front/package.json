{
  "name": "karaoke-studio",
  "version": "1.0.0",
  "description": "Karaoke Studio — десктопное приложение (AI-караоке-тренажёр)",
  "author": "Karaoke Studio",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "build:electron": "npm run build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.karaokestudio.app",
    "productName": "Karaoke Studio",
    "files": ["dist/**/*", "electron/**/*"],
    "extraResources": [
      { "from": "../backend/dist/KaraokeBackend", "to": "backend" }
    ],
    "directories": { "output": "../release" },
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Karaoke Studio"
    },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
