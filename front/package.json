{
  "name": "karaoke-studio",
  "version": "0.0.1",
  "description": "A&D Voice — десктопное приложение (AI-караоке-тренажёр)",
  "author": "A&D Voice",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "build:electron": "npm run build && electron-builder",
    "preview": "vite preview",
    "lint": "eslint src electron --ext .js,.jsx,.cjs",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"electron/**/*.cjs\" \"tests/**/*.js\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"electron/**/*.cjs\" \"tests/**/*.js\" \"scripts/**/*.mjs\"",
    "check": "npm run check:imports && npm run test:unit && npm run lint && npm run format:check && npm run build",
    "check:imports": "node scripts/check-imports.mjs",
    "test:unit": "node --experimental-default-type=module --test tests/*.test.js",
    "audit:css": "node scripts/audit-css.mjs",
    "clean:css": "node scripts/prune-unused-css.mjs && prettier --write src/**/*.css",
    "audit:exports": "node scripts/audit-exports.mjs",
    "check:sizes": "node scripts/check-file-sizes.mjs",
    "audit": "npm run check:syntax && npm run audit:css && npm run audit:exports && npm run audit:reachability && npm run audit:react && npm run audit:cycles && npm run audit:complexity && npm run check:sizes && npm run audit:duplicates && npm run audit:architecture",
    "audit:react": "node scripts/audit-react.mjs",
    "audit:cycles": "node scripts/audit-cycles.mjs",
    "audit:complexity": "node scripts/audit-complexity.mjs",
    "release:check": "node scripts/check-release.mjs",
    "test:karaoke": "node --experimental-default-type=module --test tests/karaoke-*.test.js",
    "test:coverage": "node --experimental-default-type=module --experimental-test-coverage --test tests/*.test.js",
    "test:karaoke:coverage": "node --experimental-default-type=module --experimental-test-coverage --test-coverage-include=\"src/pages/Karaoke/utils/*.js\" --test-coverage-lines=100 --test-coverage-branches=85 --test-coverage-functions=98 --test tests/karaoke-*.test.js",
    "test:ui": "node --experimental-default-type=module --test tests/*ui*.test.js tests/*visual*.test.js tests/*modal*.test.js",
    "audit:duplicates": "node scripts/audit-duplicates.mjs",
    "test:app": "node --experimental-default-type=module --test tests/*.test.js",
    "test:integrity": "node --experimental-default-type=module --test tests/jsx-integrity.test.js tests/application-behavior-contract.test.js",
    "audit:architecture": "node scripts/audit-architecture.mjs",
    "test:architecture": "node --experimental-default-type=module --test tests/architecture-policy.test.js tests/settings-form-utils.test.js tests/library-card-tilt.test.js",
    "dev:mock": "vite --mode mock",
    "build:mock": "vite build --mode mock",
    "preview:mock": "vite preview --mode mock --host 127.0.0.1 --port 4173",
    "test:e2e": "playwright test -c e2e/playwright.config.mjs",
    "test:e2e:ui": "playwright test -c e2e/playwright.config.mjs --ui",
    "audit:css:full": "node scripts/audit-css-full.mjs",
    "audit:css:strict": "node scripts/audit-css-full.mjs --strict",
    "clean": "node scripts/clean.mjs",
    "verify": "npm run check:imports && npm run test:unit && npm run lint && npm run format:check && npm run audit && npm run build",
    "verify:ui": "npm run build:mock && npm run test:e2e",
    "test:e2e:update": "playwright test -c e2e/playwright.config.mjs --update-snapshots",
    "audit:reachability": "node scripts/audit-reachability.mjs",
    "check:syntax": "node scripts/check-syntax.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^8.2.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.54.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.5.25",
    "postcss-selector-parser": "^7.1.4",
    "prettier": "^3.9.6",
    "vite": "^8.2.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.karaokestudio.app",
    "productName": "A&D Voice",
    "files": [
      {
        "from": "../build/frontend/dist",
        "to": "dist"
      },
      "electron/**/*",
      "assets/icons/**/*"
    ],
    "extraResources": [
      {
        "from": "../build/backend/dist/KaraokeBackend",
        "to": "backend"
      },
      {
        "from": "../downloads/media/videoplayback.mp4",
        "to": "media/videoplayback.mp4"
      }
    ],
    "directories": {
      "output": "../build/electron"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icons/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "A&D Voice"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
