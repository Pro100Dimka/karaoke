[
  {
    "start": 5.68,
    "end": 10.02,
    "text": "Большой широкий город магистральной дома,",
    "range": "F#3-G#3",
    "highest": "G#3",
    "lowest": "F#3",
    "avg_pitch": "G3",
    "notes_per_sec": 2.76,
    "avg_note_length": 0.309,
    "difficulty": 3.9
  },
  {
    "start": 10.48,
    "end": 13.46,
    "text": "Гусары в окнах, бесполезная тюрьма,",
    "range": "G3-A3",
    "highest": "A3",
    "lowest": "G3",
    "avg_pitch": "G#3",
    "notes_per_sec": 2.88,
    "avg_note_length": 0.313,
    "difficulty": 4.0
  },
  {
    "start": 13.7,
    "end": 16.0,
    "text": "Зеленым яблоком железо запоет,",
    "range": "F#3-A3",
    "highest": "A3",
    "lowest": "F#3",
    "avg_pitch": "G#3",
    "notes_per_sec": 3.15,
    "avg_note_length": 0.318,
    "difficulty": 4.4
  },
  {
    "start": 17.0,
    "end": 20.04,
    "text": "Ты станешь слаще, а я",
    "range": "F3-G3",
    "highest": "G3",
    "lowest": "F3",
    "avg_pitch": "G3",
    "notes_per_sec": 2.1,
    "avg_note_length": 0.36,
    "difficulty": 3.1
  },
  {
    "start": 20.04,
    "end": 23.3,
    "text": "Пропал безъест в японских лагерях,",
    "range": "F#3-G#3",
    "highest": "G#3",
    "lowest": "F#3",
    "avg_pitch": "G3",
    "notes_per_sec": 3.96,
    "avg_note_length": 0.245,
    "difficulty": 5.3
  },
  {
    "start": 23.62,
    "end": 26.46,
    "text": "Пропал голубем синицею в руке,",
    "range": "G3-G#3",
    "highest": "G#3",
    "lowest": "G3",
    "avg_pitch": "G#3",
    "notes_per_sec": 2.68,
    "avg_note_length": 0.326,
    "difficulty": 3.6
  },
  {
    "start": 26.8,
    "end": 29.0,
    "text": "Я застывал в ожидании тебя,",
    "range": "G#3-G#3",
    "highest": "G#3",
    "lowest": "G#3",
    "avg_pitch": "G#3",
    "notes_per_sec": 3.37,
    "avg_note_length": 0.274,
    "difficulty": 4.3
  },
  {
    "start": 29.51,
    "end": 31.81,
    "text": "И благодарна",
    "range": "E3-G3",
    "highest": "G3",
    "lowest": "E3",
    "avg_pitch": "F#3",
    "notes_per_sec": 4.87,
    "avg_note_length": 0.199,
    "difficulty": 5.8
  },
  {
    "start": 31.81,
    "end": 35.51,
    "text": "С тобой проводит ночь и 31 весна,",
    "range": "D4-F4",
    "highest": "F4",
    "lowest": "D4",
    "avg_pitch": "D#4",
    "notes_per_sec": 3.72,
    "avg_note_length": 0.226,
    "difficulty": 5.3
  },
  {
    "start": 36.67,
    "end": 39.81,
    "text": "И без сомнений ревнует ко всему,",
    "range": "C4-G4",
    "highest": "G4",
    "lowest": "C4",
    "avg_pitch": "E4",
    "notes_per_sec": 6.03,
    "avg_note_length": 0.162,
    "difficulty": 6.7
  },
  {
    "start": 39.85,
    "end": 42.51,
    "text": "И без сомнений ревнует ко всему,",
    "range": "F#4-G#4",
    "highest": "G#4",
    "lowest": "F#4",
    "avg_pitch": "G4",
    "notes_per_sec": 5.81,
    "avg_note_length": 0.169,
    "difficulty": 5.8
  },
  {
    "start": 43.39,
    "end": 46.39,
    "text": "Бьет все окла, а я",
    "range": "F3-A5",
    "highest": "A5",
    "lowest": "F3",
    "avg_pitch": "F#4",
    "notes_per_sec": 2.76,
    "avg_note_length": 0.277,
    "difficulty": 7.7
  },
  {
    "start": 46.39,
    "end": 49.33,
    "text": "Прощаюсь с городом посоленным туда,",
    "range": "G#3-F4",
    "highest": "F4",
    "lowest": "G#3",
    "avg_pitch": "D#4",
    "notes_per_sec": 4.37,
    "avg_note_length": 0.217,
    "difficulty": 6.7
  },
  {
    "start": 49.93,
    "end": 52.77,
    "text": "В любое время не доходит поезда,",
    "range": "C4-G4",
    "highest": "G4",
    "lowest": "C4",
    "avg_pitch": "E4",
    "notes_per_sec": 3.82,
    "avg_note_length": 0.228,
    "difficulty": 6.1
  },
  {
    "start": 53.13,
    "end": 54.51,
    "text": "И губы частной здесь обвертлены,",
