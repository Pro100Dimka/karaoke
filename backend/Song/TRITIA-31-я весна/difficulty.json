    "difficulty": 5.6
  },
  {
    "start": 58.91,
    "end": 62.49,
    "text": "Роседь, все ламя крылья, паутина, провода,",
    "range": "E3-G#3",
    "highest": "G#3",
    "lowest": "E3",
    "avg_pitch": "F#3",
    "notes_per_sec": 3.96,
    "avg_note_length": 0.213,
    "difficulty": 5.8
  },
  {
    "start": 62.97,
    "end": 65.89,
    "text": "Я мягким тыгром сторожу тебя во пне,",
    "range": "G3-G#3",
    "highest": "G#3",
    "lowest": "G3",
    "avg_pitch": "G#3",
    "notes_per_sec": 3.37,
    "avg_note_length": 0.276,
    "difficulty": 4.4
  },
  {
    "start": 66.35,
    "end": 68.91,
    "text": "И обалдевшая от межности вода",
    "range": "E3-G#3",
    "highest": "G#3",
    "lowest": "E3",
    "avg_pitch": "G3",
